<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/chibi_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">
    <ImageView
        android:id="@+id/widget_chibi_image"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:contentDescription="Chibi companion" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="7dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#4C2D38"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="#7A5761"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/widget_pet_action"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/chibi_pet_button"
            android:gravity="center"
            android:paddingHorizontal="11dp"
            android:textColor="#A84E60"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#8C6872"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/widget_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#B27A87"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
